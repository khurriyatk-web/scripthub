# ScriptHub configuration
# Copy this to .env and fill in real values

# ─── Telegram Bot ───
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
BOT_USERNAME=ScriptHubBot

# ─── Web / API ───
# Public backend URL (Caddy serves this)
BACKEND_URL=https://scripthub.techmentor.uz:3443
# Frontend URL (Vercel)
FRONTEND_URL=https://scripthub.vercel.app
# Internal FastAPI host/port (Caddy proxies to this)
API_HOST=127.0.0.1
API_PORT=8000

# ─── Database ───
DATABASE_URL=sqlite+aiosqlite:///./database/scripthub.db

# ─── Security ───
SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── Storage ───
STORAGE_PATH=./storage
MAX_UPLOAD_MB=200

# ─── Caddy ───
CADDY_DOMAIN=scripthub.techmentor.uz
CADDY_PORT=3443

# ─── Paths ───
LOG_PATH=./logs
